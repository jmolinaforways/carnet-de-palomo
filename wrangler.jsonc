{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnet-de-palomo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // El dominio del meme. Con custom_domain Cloudflare crea el registro DNS
  // y el certificado por su cuenta; no hay que tocar el DNS a mano.
  // Se queda encendida como respaldo mientras las cachés de DNS del mundo
  // expiran. Una vez que palomos.com.do responda en todas partes, se puede
  // apagar para tener una sola dirección.
  "workers_dev": true,

  "routes": [
    { "pattern": "palomos.com.do", "custom_domain": true },
    { "pattern": "www.palomos.com.do", "custom_domain": true }
  ],

  // El contador de secuenciales. Es lo único con estado en todo el
  // proyecto, y solo guarda un número: cuántos carnets se han emitido.
  "durable_objects": {
    "bindings": [
      { "name": "SECUENCIA", "class_name": "Secuencia" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Secuencia"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
